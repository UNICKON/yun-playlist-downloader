{
  "compilerOptions": {
    "paths": {
      "$*": ["./src/*"]
    },
    "target": "es2025",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src", "test"],
  "exclude": ["scripts", "dist", "node_modules"]
}
